# =============================================================================
# HUB by Raisen — Template de Variables de Entorno
# Copiar a .env.development y completar con valores reales
# =============================================================================
APP_ENV=development
APP_URL=http://localhost:3000

# SUPABASE (Dashboard > Settings > API)
SUPABASE_URL=your_supabase_url
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
SUPABASE_ANON_KEY=your_anon_key
# REQUERIDO tambien en Railway (Hotfix G): sin el, TODA ruta con JWT responde 500 config_incompleta.
# Valor: Supabase Dashboard > Settings > API > JWT Secret. Nunca lo pegues en chats ni commits.
SUPABASE_JWT_SECRET=your_jwt_secret

# CANALES (opcional para desarrollo)
ZERNIO_API_KEY=
RESEND_API_KEY=

# CANAL SIMULADO (dev-channel) — ids del mensaje de prueba en local
# Se crean con: bash scripts/setup-canales.sh
DEV_CONVERSATION_ID=
DEV_CONTACT_ID=
DEV_TENANT_ID=

# IA (opcional para desarrollo)
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
QWEN_API_KEY=

# PAGOS (opcional para desarrollo)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_API_VERSION=2024-10-28.acacia
# URLs de retorno de onboarding Stripe (configurar al desplegar):
# STRIPE_ONBOARDING_REFRESH_URL=https://<HUB-DOMAIN>/tenants/stripe-onboarding/refresh
# STRIPE_ONBOARDING_RETURN_URL=https://<HUB-DOMAIN>/tenants/stripe-onboarding/complete

# ATH Movil Business (3.2a-BIS) — NO hay sandbox (R13).
# Los tokens publicToken/privateToken por tenant viven CIFRADOS en
# payment_methods_config.secrets_encrypted (via decrypt_secret/encrypt_secret).
# ATH_MOVIL_STUB=1 fuerza adapter en stub (sin red) SOLO para dev/tests. Nunca en prod.
ATH_MOVIL_STUB=

# LANDING PÚBLICA DE COBRO (Slide 3.3)
# CSRF_SECRET: clave HMAC-SHA256 de 32 bytes (hex, 64 chars) para tokens CSRF. Generar con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CSRF_SECRET=
# URL pública del HUB (para redirects de resultado/onboarding). Dev local:
HUB_PUBLIC_URL=http://localhost:8080
# Publishable key de Stripe (pk_live_ / pk_test_) para el embed de Stripe.js en la landing.
STRIPE_PUBLISHABLE_KEY=
# Código de país por defecto para normalizar teléfonos ATH (default 1 = US/PR).
HUB_DEFAULT_COUNTRY_CODE=1

# MONITOREO (opcional para desarrollo)
SENTRY_DSN=