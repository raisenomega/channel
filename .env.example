# =============================================================================
# HUB by Raisen — Template de Variables de Entorno
# Copiar a .env.development y completar con valores reales
# =============================================================================
APP_ENV=development
APP_URL=http://localhost:3000

# SUPABASE (Dashboard > Settings > API)
SUPABASE_URL=your_supabase_url
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
SUPABASE_ANON_KEY=your_anon_key
SUPABASE_JWT_SECRET=your_jwt_secret

# CANALES (opcional para desarrollo)
ZERNIO_API_KEY=
RESEND_API_KEY=

# CANAL SIMULADO (dev-channel) — ids del mensaje de prueba en local
# Se crean con: bash scripts/setup-canales.sh
DEV_CONVERSATION_ID=
DEV_CONTACT_ID=
DEV_TENANT_ID=

# IA (opcional para desarrollo)
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
QWEN_API_KEY=

# PAGOS (opcional para desarrollo)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ATH Movil Business (3.2a-BIS) — NO hay sandbox (R13).
# Los tokens publicToken/privateToken por tenant viven CIFRADOS en
# payment_methods_config.secrets_encrypted (via decrypt_secret/encrypt_secret).
# ATH_MOVIL_STUB=1 fuerza adapter en stub (sin red) SOLO para dev/tests. Nunca en prod.
ATH_MOVIL_STUB=

# MONITOREO (opcional para desarrollo)
SENTRY_DSN=