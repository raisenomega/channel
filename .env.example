# =============================================================================
# HUB by Raisen — Template de Variables de Entorno
# Copiar a .env.development y completar con valores reales
# =============================================================================
APP_ENV=development
APP_URL=http://localhost:3000

# SUPABASE (Dashboard > Settings > API)
SUPABASE_URL=your_supabase_url
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
SUPABASE_JWT_SECRET=your_jwt_secret

# CANALES (opcional para desarrollo)
ZERNIO_API_KEY=
RESEND_API_KEY=

# IA (opcional para desarrollo)
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
QWEN_API_KEY=

# PAGOS (opcional para desarrollo)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# MONITOREO (opcional para desarrollo)
SENTRY_DSN=