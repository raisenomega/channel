# =============================================================================
# HUB by Raisen — Template de Variables de Entorno
# Copiar a .env.development y completar con valores reales
# =============================================================================
APP_ENV=development
APP_URL=http://localhost:3000

# SUPABASE (Dashboard > Settings > API)
SUPABASE_URL=your_supabase_url
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
SUPABASE_ANON_KEY=your_anon_key
SUPABASE_JWT_SECRET=your_jwt_secret

# CANALES (opcional para desarrollo)
ZERNIO_API_KEY=
RESEND_API_KEY=

# CANAL SIMULADO (dev-channel) — ids del mensaje de prueba en local
# Se crean con: bash scripts/setup-canales.sh
DEV_CONVERSATION_ID=
DEV_CONTACT_ID=
DEV_TENANT_ID=

# IA (opcional para desarrollo)
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
QWEN_API_KEY=

# PAGOS (opcional para desarrollo)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_API_VERSION=2024-10-28.acacia
# URLs de retorno de onboarding Stripe (configurar al desplegar):
# STRIPE_ONBOARDING_REFRESH_URL=https://<HUB-DOMAIN>/tenants/stripe-onboarding/refresh
# STRIPE_ONBOARDING_RETURN_URL=https://<HUB-DOMAIN>/tenants/stripe-onboarding/complete

# ATH Movil Business - sandbox (opcional; sin esto el adapter corre en stub mode)
ATH_MOVIL_SANDBOX_PUBLIC_TOKEN=
ATH_MOVIL_SANDBOX_PRIVATE_TOKEN=

# Webhook URL ATH Movil (configurada por el tenant en el portal ATH Movil en onboarding):
# https://<HUB-DOMAIN>/webhooks/ath-movil/{tenantId}
# No se setea en env de HUB — es info que HUB ensena al tenant en su onboarding UI.
# En produccion cada tenant provee sus propios tokens via portal de HUB.
# Los tokens se cifran con pgp_sym_encrypt y viven en payment_methods_config.secrets_encrypted.

# MONITOREO (opcional para desarrollo)
SENTRY_DSN=