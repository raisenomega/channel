{
  "name": "hub-by-raisen",
  "version": "0.1.0",
  "private": true,
  "description": "HUB by Raisen — Plataforma 12: comunicacion omnicanal con opcion de autonomia IA",
  "type": "module",
  "scripts": {
    "dev": "bash scripts/dev-server.sh",
    "build": "bash scripts/build.sh",
    "start": "bash scripts/start-server.sh",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write src/",
    "test": "echo 'FASE 0: sin tests aun'",
    "test:unit": "vitest run tests/unit/",
    "test:integration": "vitest run tests/integration/",
    "test:watch": "vitest",
    "test:e2e": "playwright test --config=tests/e2e/playwright.config.ts",
    "check:lines": "bash scripts/check-lines.sh",
    "check:layers": "bash scripts/check-layers.sh",
    "check:emojis": "bash scripts/check-emojis.sh",
    "check:auth": "bash scripts/check-auth.sh",
    "check:migrations": "bash scripts/check-migrations-drift.sh",
    "check:build": "rm -rf dist/ && pnpm exec tsc --project tsconfig.build.json",
    "check:server-smoke": "bash scripts/check-server-smoke.sh",
    "check:tanstack": "cd apps/tanstack && pnpm typecheck",
    "check:all": "pnpm typecheck && pnpm lint && pnpm check:lines && pnpm check:layers && pnpm check:emojis && pnpm check:build && pnpm check:server-smoke && pnpm check:tanstack",
    "db:push": "supabase db push",
    "db:reset": "bash scripts/reset-dev-db.sh",
    "db:migrate": "supabase migration up",
    "db:rollback": "supabase migration down",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint-community/eslint-utils": "^4.10.1",
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.0.0",
    "@types/node": "^22",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.71.2",
    "eslint": "^9",
    "eslint-visitor-keys": "^5.0.1",
    "husky": "^9",
    "jsdom": "^25.0.0",
    "lint-staged": "^15",
    "prettier": "^3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "typescript-eslint": "^8.71.2",
    "vitest": "^3"
  },
  "lint-staged": {
    "*.ts": [
      "pnpm lint:fix",
      "pnpm format"
    ]
  },
  "dependencies": {
    "@noble/ciphers": "^2.4.0",
    "@supabase/supabase-js": "^2.117.3",
    "jose": "^6.2.12"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  }
}