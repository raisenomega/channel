{
  "name": "hub-by-raisen",
  "version": "0.1.0",
  "private": true,
  "description": "HUB by Raisen — Plataforma 12: comunicacion omnicanal con opcion de autonomia IA",
  "type": "module",
  "scripts": {
    "dev": "echo 'FASE 0: estructura scaffolding lista para desarrollo'",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write src/",
    "test": "echo 'FASE 0: sin tests aun'",
    "test:unit": "deno test tests/unit/",
    "test:integration": "deno test tests/integration/",
    "check:lines": "bash scripts/check-lines.sh",
    "check:layers": "bash scripts/check-layers.sh",
    "check:emojis": "bash scripts/check-emojis.sh",
    "check:all": "pnpm typecheck && pnpm lint && pnpm check:lines && pnpm check:layers && pnpm check:emojis",
    "db:push": "supabase db push",
    "db:reset": "bash scripts/reset-dev-db.sh",
    "db:migrate": "supabase migration up",
    "db:rollback": "supabase migration down",
    "prepare": "husky"
  },
  "devDependencies": {
    "@types/node": "^22",
    "eslint": "^9",
    "husky": "^9",
    "lint-staged": "^15",
    "prettier": "^3",
    "typescript": "^5"
  },
  "lint-staged": {
    "*.ts": ["pnpm lint:fix", "pnpm format"]
  }
}